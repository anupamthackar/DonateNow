# Environment Variables — DonateNow
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git

# Reference: security.mdc | deployment.mdc

# ============================================
# RAZORPAY CONFIGURATION
# ============================================

# Razorpay Key ID (public — safe for client-side)
# Get from: Razorpay Dashboard → Settings → API Keys
# Test mode keys start with: rzp_test_
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxxx

# Razorpay Key Secret (server-only — NEVER expose to client)
# Get from: Razorpay Dashboard → Settings → API Keys
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Razorpay Webhook Secret (server-only)
# Get from: Razorpay Dashboard → Settings → Webhooks → Secret
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# SUPABASE CONFIGURATION
# ============================================

# Supabase Project URL (public — safe for client-side)
# Get from: Supabase Dashboard → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxx.supabase.co

# Supabase Anon Key (public — safe with RLS enabled)
# Get from: Supabase Dashboard → Settings → API → anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx

# Supabase Service Role Key (server-only — bypasses RLS)
# Get from: Supabase Dashboard → Settings → API → service_role
# WARNING: This key bypasses Row Level Security. Use only in server-side code.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx

# ============================================
# APPLICATION CONFIGURATION
# ============================================

# Base URL of the application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# NAMING CONVENTION
# ============================================
# NEXT_PUBLIC_* → Exposed to client-side (browser)
# No prefix     → Server-side only (API routes, webhooks)
#
# See security.mdc → Section 5 for detailed rules
