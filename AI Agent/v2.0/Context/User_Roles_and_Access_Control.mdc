## 3. RLS Policy Mapping

### `users` Table

```sql
-- Users can read their own profile
CREATE POLICY "users_select_own" ON users
  FOR SELECT USING (auth.uid() = supabase_auth_id);

-- Users can update their own profile
CREATE POLICY "users_update_own" ON users
  FOR UPDATE USING (auth.uid() = supabase_auth_id);

-- Admin can read all users
CREATE POLICY "users_select_admin" ON users
  FOR SELECT USING (
    EXISTS (SELECT 1 FROM users WHERE supabase_auth_id = auth.uid() AND role = 'admin')
  );
```

### `donation_profiles` Table

```sql
-- Public: Anyone can read verified, active campaigns
CREATE POLICY "profiles_select_public" ON donation_profiles
  FOR SELECT USING (verification_status = 'verified' AND is_active = true);

-- Creator: Can read all own campaigns (any status)
CREATE POLICY "profiles_select_creator" ON donation_profiles
  FOR SELECT USING (creator_id IN (SELECT id FROM users WHERE supabase_auth_id = auth.uid()));

-- Creator: Can insert new campaigns
CREATE POLICY "profiles_insert_creator" ON donation_profiles
  FOR INSERT WITH CHECK (creator_id IN (SELECT id FROM users WHERE supabase_auth_id = auth.uid()));

-- Creator: Can update own campaigns
CREATE POLICY "profiles_update_creator" ON donation_profiles
  FOR UPDATE USING (creator_id IN (SELECT id FROM users WHERE supabase_auth_id = auth.uid()));

-- Admin: Can read all campaigns
CREATE POLICY "profiles_select_admin" ON donation_profiles
  FOR SELECT USING (
    EXISTS (SELECT 1 FROM users WHERE supabase_auth_id = auth.uid() AND role = 'admin')
  );

-- Admin: Can update any campaign (for verification)
CREATE POLICY "profiles_update_admin" ON donation_profiles
  FOR UPDATE USING (
    EXISTS (SELECT 1 FROM users WHERE supabase_auth_id = auth.uid() AND role = 'admin')
  );
```

### `donations` Table

```sql
-- Public: Donor wall query (non-anonymous, completed donations — name and amount only)
CREATE POLICY "donations_select_public_wall" ON donations
  FOR SELECT USING (status = 'completed' AND is_anonymous = false);

-- Registered Donor: Can view own donations
CREATE POLICY "donations_select_donor" ON donations
  FOR SELECT USING (donor_user_id IN (SELECT id FROM users WHERE supabase_auth_id = auth.uid()));

-- Creator: Can view donations to own campaigns
CREATE POLICY "donations_select_creator" ON donations
  FOR SELECT USING (
    campaign_id IN (SELECT id FROM donation_profiles WHERE creator_id IN (SELECT id FROM users WHERE supabase_auth_id = auth.uid()))
  );

-- Admin: Can view all donations
CREATE POLICY "donations_select_admin" ON donations
  FOR SELECT USING (
    EXISTS (SELECT 1 FROM users WHERE supabase_auth_id = auth.uid() AND role = 'admin')
  );

-- INSERT: Only via Edge Functions (service_role), not direct client
```

### `verification_requests` Table

```sql
-- Creator: Can view own verification requests
CREATE POLICY "verification_select_creator" ON verification_requests
  FOR SELECT USING (
    campaign_id IN (SELECT id FROM donation_profiles WHERE creator_id IN (SELECT id FROM users WHERE supabase_auth_id = auth.uid()))
  );

-- Creator: Can insert verification requests for own campaigns
CREATE POLICY "verification_insert_creator" ON verification_requests
  FOR INSERT WITH CHECK (
    campaign_id IN (SELECT id FROM donation_profiles WHERE creator_id IN (SELECT id FROM users WHERE supabase_auth_id = auth.uid()))
  );

-- Admin: Can view all verification requests
CREATE POLICY "verification_select_admin" ON verification_requests
  FOR SELECT USING (
    EXISTS (SELECT 1 FROM users WHERE supabase_auth_id = auth.uid() AND role = 'admin')
  );

-- Admin: Can update verification requests (approve/reject)
CREATE POLICY "verification_update_admin" ON verification_requests
  FOR UPDATE USING (
    EXISTS (SELECT 1 FROM users WHERE supabase_auth_id = auth.uid() AND role = 'admin')
  );
```

### `tax_receipts` Table

```sql
-- Donor: Can view own receipts
CREATE POLICY "receipts_select_donor" ON tax_receipts
  FOR SELECT USING (
    donation_id IN (SELECT id FROM donations WHERE donor_user_id IN (SELECT id FROM users WHERE supabase_auth_id = auth.uid()))
  );

-- INSERT: Only via Edge Functions (service_role)
```

### `subscriptions` Table

```sql
-- User: Can view own subscriptions
CREATE POLICY "subscriptions_select_own" ON subscriptions
  FOR SELECT USING (user_id IN (SELECT id FROM users WHERE supabase_auth_id = auth.uid()));

-- User: Can update own subscriptions (cancel)
CREATE POLICY "subscriptions_update_own" ON subscriptions
  FOR UPDATE USING (user_id IN (SELECT id FROM users WHERE supabase_auth_id = auth.uid()));

-- INSERT/DELETE: Only via Edge Functions (service_role)
```

### `impact_reports` Table

```sql
-- Creator: Can view reports for own campaigns
CREATE POLICY "reports_select_creator" ON impact_reports
  FOR SELECT USING (
    campaign_id IN (SELECT id FROM donation_profiles WHERE creator_id IN (SELECT id FROM users WHERE supabase_auth_id = auth.uid()))
  );

-- Admin: Can view all reports
CREATE POLICY "reports_select_admin" ON impact_reports
  FOR SELECT USING (
    EXISTS (SELECT 1 FROM users WHERE supabase_auth_id = auth.uid() AND role = 'admin')
  );

-- INSERT: Only via Edge Functions (service_role)
```

