## 5. Rollback Script

```sql
-- ============================================
-- v2.0 Migration Rollback Script
-- ============================================
-- USE WITH CAUTION: Only if migration must be reversed.
-- ============================================

BEGIN;

-- Step 1: Remove new columns from donations
ALTER TABLE donations DROP COLUMN IF EXISTS campaign_id;
ALTER TABLE donations DROP COLUMN IF EXISTS donor_user_id;
ALTER TABLE donations DROP COLUMN IF EXISTS is_anonymous;
ALTER TABLE donations DROP COLUMN IF EXISTS subscription_id;
ALTER TABLE donations DROP COLUMN IF EXISTS receipt_id;

-- Step 2: Drop new tables (in dependency order)
DROP TABLE IF EXISTS impact_reports CASCADE;
DROP TABLE IF EXISTS campaign_progress CASCADE;
DROP TABLE IF EXISTS tax_receipts CASCADE;
DROP TABLE IF EXISTS payment_logs CASCADE;
DROP TABLE IF EXISTS subscriptions CASCADE;
DROP TABLE IF EXISTS verification_requests CASCADE;
DROP TABLE IF EXISTS donation_profiles CASCADE;
DROP TABLE IF EXISTS users CASCADE;

-- Step 3: Drop new functions
DROP FUNCTION IF EXISTS get_campaign_stats(UUID);
DROP FUNCTION IF EXISTS get_platform_stats();
DROP FUNCTION IF EXISTS update_campaign_raised_amount();
DROP FUNCTION IF EXISTS generate_receipt_number();
DROP SEQUENCE IF EXISTS receipt_number_seq;

COMMIT;

-- v1.0 tables (causes, donations, admin_users) remain untouched.
```

