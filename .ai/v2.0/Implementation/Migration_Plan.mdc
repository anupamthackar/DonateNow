## 4. Migration SQL Script

```sql
-- ============================================
-- DonateNow v1.0 → v2.0 Migration Script
-- ============================================
-- Run AFTER 005_v2_schema.sql creates the new tables
-- Run BEFORE 006_v2_security.sql applies RLS
-- ============================================

BEGIN;

-- Step 1: Migrate admin_users → users
-- Preserve original UUIDs for foreign key integrity
INSERT INTO users (id, email, name, phone, role, avatar_url, supabase_auth_id, is_active, created_at, updated_at)
SELECT
    id,
    email,
    name,
    NULL,           -- phone (not in v1.0)
    role,           -- preserves 'admin'
    NULL,           -- avatar_url (not in v1.0)
    supabase_auth_id,
    true,           -- is_active
    created_at,
    updated_at
FROM admin_users
ON CONFLICT (supabase_auth_id) DO NOTHING;

-- Step 2: Migrate causes → donation_profiles
-- Use first admin user as creator_id for migrated causes
INSERT INTO donation_profiles (
    id, creator_id, title, description, category, target_amount,
    raised_amount, image_url, verification_status, is_active,
    start_date, end_date, created_at, updated_at
)
SELECT
    c.id,
    (SELECT id FROM users WHERE role = 'admin' LIMIT 1),  -- assign to first admin
    c.title,
    c.description,
    'general',          -- default category
    c.target_amount,
    c.raised_amount,
    c.image_url,
    'verified',         -- pre-existing causes are trusted
    c.is_active,
    c.created_at,       -- start_date = creation date
    NULL,               -- no end_date
    c.created_at,
    c.updated_at
FROM causes c
ON CONFLICT (id) DO NOTHING;

-- Step 3: Add new columns to donations table
ALTER TABLE donations ADD COLUMN IF NOT EXISTS campaign_id UUID REFERENCES donation_profiles(id);
ALTER TABLE donations ADD COLUMN IF NOT EXISTS donor_user_id UUID REFERENCES users(id);
ALTER TABLE donations ADD COLUMN IF NOT EXISTS is_anonymous BOOLEAN DEFAULT false;
ALTER TABLE donations ADD COLUMN IF NOT EXISTS subscription_id UUID;
ALTER TABLE donations ADD COLUMN IF NOT EXISTS receipt_id UUID;

-- Step 4: Backfill campaign_id from cause_id
UPDATE donations
SET campaign_id = cause_id
WHERE cause_id IS NOT NULL AND campaign_id IS NULL;

-- Step 5: Create indexes on new columns
CREATE INDEX IF NOT EXISTS idx_donations_campaign_id ON donations(campaign_id);
CREATE INDEX IF NOT EXISTS idx_donations_donor_user_id ON donations(donor_user_id);
CREATE INDEX IF NOT EXISTS idx_donations_is_anonymous ON donations(is_anonymous);

COMMIT;

-- ============================================
-- Post-Migration Verification Queries
-- ============================================

-- Verify user migration count
-- SELECT COUNT(*) FROM users;
-- SELECT COUNT(*) FROM admin_users;
-- These should match.

-- Verify campaign migration
-- SELECT COUNT(*) FROM donation_profiles;
-- SELECT COUNT(*) FROM causes;
-- These should match.

-- Verify donation backfill
-- SELECT COUNT(*) FROM donations WHERE cause_id IS NOT NULL AND campaign_id IS NULL;
-- This should return 0.

-- Verify no orphaned donations
-- SELECT COUNT(*) FROM donations d
-- LEFT JOIN donation_profiles dp ON d.campaign_id = dp.id
-- WHERE d.campaign_id IS NOT NULL AND dp.id IS NULL;
-- This should return 0.
```

